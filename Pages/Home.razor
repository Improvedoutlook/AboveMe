    /// <summary>
    /// Save current user preferences to localStorage for persistence across sessions.
    /// </summary>
    private async Task SaveUserPreferencesAsync()
    {
        try
        {
            var preferences = new UserLocationPreferences
            {
                Country = selectedCountry,
                City = selectedCity,
                Timezone = selectedTimezone,
                Latitude = userLatitude,
                Longitude = userLongitude,
                LastUpdated = DateTime.UtcNow
            };
            
            await LocalStorage.SetItemAsync("userLocationPreferences", preferences);
            Console.WriteLine($"Saved user preferences: Country={selectedCountry}, City={selectedCity}, Timezone={selectedTimezone}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving user preferences: {ex.Message}");
        }
    }

