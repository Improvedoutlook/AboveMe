    bool IsNasaQueryChanged()
    {
        // Example: cache by lat/lon, country, city, timezone, or whatever NASA API uses
        var currentParams = new { selectedCountry, selectedCity, selectedTimezone, userLatitude, userLongitude };
        if (lastNasaQueryParams == null) return true;
        return !System.Text.Json.JsonSerializer.Serialize(currentParams).Equals(System.Text.Json.JsonSerializer.Serialize(lastNasaQueryParams));
    }

    void UpdateLastNasaQuery()
    {
        lastNasaQueryParams = new { selectedCountry, selectedCity, selectedTimezone, userLatitude, userLongitude };
    }

    async Task FetchNasaDataAsync()
    {
        if (!IsNasaQueryChanged() && cachedNasaData != null)
        {
            nasaData = cachedNasaData;
            NasaError = string.Empty;
            return;
        }
        if (string.IsNullOrWhiteSpace(nasaApiKey))
        {
            NasaError = "NASA API key is missing.";
            return;
        }
        // For APOD, lat/lon are not required, so we just call the endpoint for the current date
        string? url = $"https://api.nasa.gov/planetary/apod?api_key={nasaApiKey}";
        try
        {
            HttpResponseMessage? response = await Http.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                string? json = await response.Content.ReadAsStringAsync();
                nasaData = System.Text.Json.JsonSerializer.Deserialize<NasaApodData>(json, options: new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                cachedNasaData = nasaData;
                UpdateLastNasaQuery();
                NasaError = string.Empty;
            }
            else
            {
                NasaError = $"Currently, NASA APIs are experiencing an unscheduled outage. Users are advised to check back later for updates on the status of the APIs. data. Status: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            NasaError = $"Error: {ex.Message}";
        }
    }

    // Helpers for APOD media handling
    private bool IsDirectVideoUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return false;
        string u = url.Trim().ToLowerInvariant();
        return u.EndsWith(".mp4") || u.EndsWith(".webm") || u.EndsWith(".ogg") || u.EndsWith(".ogv") || u.EndsWith(".mov") || u.EndsWith(".m4v");
    }

    private string GetVideoMimeType(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return "video/mp4";
        string u = url.Trim().ToLowerInvariant();
        if (u.EndsWith(".webm")) return "video/webm";
        if (u.EndsWith(".ogg") || u.EndsWith(".ogv")) return "video/ogg";
        if (u.EndsWith(".mov") || u.EndsWith(".m4v")) return "video/quicktime";
        return "video/mp4";
    }

    private string? GetYouTubeEmbedUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return null;
        try
        {
            var u = new Uri(url);
            string lower = u.Host.ToLowerInvariant();
            string id = string.Empty;
            if (lower.Contains("youtu.be"))
            {
                id = u.AbsolutePath.Trim('/');
            }
            else if (lower.Contains("youtube.com"))
            {
                if (u.AbsolutePath.Contains("/embed/"))
                {
                    id = u.AbsolutePath.Split("/embed/")[1].Split('?')[0];
                }
                else
                {
                    // Parse query for v=
                    var q = u.Query ?? string.Empty;
                    var m = System.Text.RegularExpressions.Regex.Match(q, "[&?]v=([^&]+)");
                    if (m.Success)
                    {
                        id = m.Groups[1].Value;
                    }
                }
            }

            if (string.IsNullOrEmpty(id)) return null;
            return $"https://www.youtube.com/embed/{id}?rel=0&modestbranding=1&playsinline=1";
        }
        catch
        {
            return null;
        }
    }

