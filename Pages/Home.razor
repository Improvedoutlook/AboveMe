    /// <summary>
    /// Fetch JWST data from STScI MAST archive
    /// </summary>
    async Task FetchWebbDataAsync()
    {
        isLoadingWebbData = true;
        WebbError = string.Empty;
        jwstImageData = null;
        StateHasChanged();

        try
        {
            // Get a random JWST image from the MAST archive
            jwstImageData = await JwstService.GetRandomJwstImageAsync();

            if (jwstImageData == null)
            {
                WebbError = "No JWST images found in the archive. The telescope data may be temporarily unavailable.";
                return;
            }

            // Set initial image URL to preview (index 0)
            imageUrlIndex = 0;
            currentImageUrl = jwstImageData.PreviewUrl;
            
            // Debug: Log the image URL
            await JS.InvokeVoidAsync("console.log", $"JWST Image URL: {currentImageUrl}");
            await JS.InvokeVoidAsync("console.log", $"JWST Target: {jwstImageData.TargetName}");

            WebbError = string.Empty;
        }
        catch (Exception ex)
        {
            WebbError = $"Failed to load JWST data from STScI MAST archive: {ex.Message}";
            await JS.InvokeVoidAsync("console.error", $"JWST fetch error: {ex}");
        }
        finally
        {
            isLoadingWebbData = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Handle image loading errors by trying fallback URLs
    /// </summary>
    async Task HandleImageError()
    {
        if (jwstImageData == null) return;

        imageUrlIndex++;

        // Try fallback URLs: preview -> thumbnail -> full size
        currentImageUrl = imageUrlIndex switch
        {
            0 => jwstImageData.PreviewUrl,
            1 => jwstImageData.ThumbnailUrl,
            2 => jwstImageData.FullSizeUrl,
            _ => string.Empty
        };

        if (string.IsNullOrEmpty(currentImageUrl) || imageUrlIndex > 2)
        {
            WebbError = "Unable to load preview image for this observation. The image may not be available yet.";
            await JS.InvokeVoidAsync("console.warn", $"All image URLs failed for observation {jwstImageData.ObsId}");
        }

        StateHasChanged();
    }
