    /// <summary>
    /// Loads the curated comet forecast catalog via CometService, filters by the
    /// user's latitude, and persists the filtered result in localStorage keyed
    /// on (rounded-lat, today-UTC) so subsequent toggles within the same day
    /// are instant and resilient to network blips.
    /// </summary>
    async Task FetchCometsAsync()
    {
        if (isLoadingComets) return;

        double? lat = null;
        if (!string.IsNullOrWhiteSpace(userLatitude) &&
            double.TryParse(userLatitude, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var parsedLat))
        {
            lat = parsedLat;
        }

        // Cache key: lat rounded to 0.5° (~55 km) + today UTC.
        // Granularity tradeoff: too fine wastes cache slots; too coarse yields
        // visibly wrong filters near the equator for high-declination comets.
        double roundedLat = lat.HasValue ? Math.Round(lat.Value * 2) / 2.0 : 999;
        string latKey = lat.HasValue
            ? roundedLat.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)
            : "global";
        string cacheKey = $"cometForecasts_v1:{latKey}:{DateTime.UtcNow.Date:yyyyMMdd}";

        if (cacheKey == lastCometsCacheKey && VisibleComets.Count > 0)
        {
            return; // Already loaded for this key in this session.
        }

        // Try localStorage cache first.
        try
        {
            var cached = await LocalStorage.GetItemAsync<List<CometForecast>>(cacheKey);
            if (cached != null)
            {
                VisibleComets = cached;
                CometError = string.Empty;
                lastCometsCacheKey = cacheKey;
                StateHasChanged();
                return;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"comet localStorage read failed: {ex.Message}");
        }

        isLoadingComets = true;
        CometError = string.Empty;
        StateHasChanged();
        try
        {
            var forecasts = await CometService.GetVisibleForecastsAsync(lat);
            VisibleComets = forecasts;
            lastCometsCacheKey = cacheKey;
            try
            {
                await LocalStorage.SetItemAsync(cacheKey, forecasts);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"comet localStorage write failed (non-fatal): {ex.Message}");
            }
        }
        catch (Exception ex)
        {
            CometError = $"Unable to load comet forecasts: {ex.Message}";
        }
        finally
        {
            isLoadingComets = false;
            StateHasChanged();
        }
    }    /// <summary>
    /// Returns a Bootstrap-friendly background color for comet status pills.
    /// DisplayStatus is derived from current date so labels stay accurate.
    /// </summary>
