    private string currentImageUrl = string.Empty;
    private int imageUrlIndex = 0; // 0 = preview, 1 = thumbnail, 2 = full size

    protected override void OnInitialized()
    {
        selectedCountry = "";
        selectedCity = "";
        selectedTimezone = "";
        shareLocation = false;
        showMoonPhases = false;
        showLunarEclipse = false;
        showConstellations = false;
        showComets = false;
        showWebb = false;
        ipGeoApiKey = Environment.GetEnvironmentVariable(variable: "IPGEO_API_KEY");
        // Use the provided ipgeolocation API key directly
        astronomyApiKey = "7b308a582e5043d8a59ae2edcd5296d8";
        // NASA API key: set via env var for security, fallback to provided key for demo only
        nasaApiKey = Environment.GetEnvironmentVariable(variable: "NASA_API_KEY") ?? "DCOJ8SYkVW49IyCH8mhZJuGamWTIYfW2Hhd6afgX";
    }

    bool IsQueryChanged()
    {
        return selectedCountry != lastCountry ||
               selectedCity != lastCity ||
               selectedTimezone != lastTimezone ||
               userLatitude != lastLatitude ||
               userLongitude != lastLongitude;
    }

    void UpdateLastQuery()
    {
        lastCountry = selectedCountry;
        lastCity = selectedCity;
        lastTimezone = selectedTimezone;
        lastLatitude = userLatitude;
        lastLongitude = userLongitude;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(selectedCountry))
        {
            Cities = selectedCountry switch
            {
                "United States" => new List<string>() { "New York", "Los Angeles", "Chicago" },
                "Canada" => new List<string>() { "Toronto", "Vancouver", "Montreal" },
                "United Kingdom" => new List<string>() { "London", "Manchester", "Birmingham" },
                "Australia" => new List<string>() { "Sydney", "Melbourne", "Brisbane" },
                _ => new List<string>()
            };
            await FetchAstronomyDataAsync();
        }
        else if (!string.IsNullOrEmpty(selectedTimezone))
        {
            // Assign a city and state based on US timezone selection
            string city = string.Empty;
            string state = string.Empty;
            string country = "United States";
            switch (selectedTimezone)
            {
                case "Eastern Standard Time":
                    city = "New York";
                    state = "NY";
                    break;
                case "Central Standard Time":
                    city = "Kansas City";
                    state = "KS";
                    break;
                case "Mountain Standard Time":
                    city = "Denver";
                    state = "CO";
                    break;
                case "Pacific Standard Time":
                    city = "Los Angeles";
                    state = "CA";
                    break;
                case "Greenwich Mean Time":
                    city = "London";
                    state = string.Empty;
                    country = "United Kingdom";
                    break;
                case "Central European Time":
                    city = "Berlin";
                    state = string.Empty;
                    country = "Germany";
                    break;
                case "Australian Eastern Time":
                    city = "Sydney";
                    state = string.Empty;
                    country = "Australia";
                    break;
                case "China Standard Time":
                    city = "Beijing";
                    state = string.Empty;
                    country = "China";
                    break;
                default:
                    city = string.Empty;
                    state = string.Empty;
                    country = string.Empty;
                    break;
            }
            selectedCity = city;
            Cities = string.IsNullOrEmpty(city) ? new List<string>() : new List<string>() { city };
            // Store state and country for location string
            selectedCountry = country;
            await FetchAstronomyDataAsync();
        }
        else
        {
            Cities = new List<string>();
        }
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && shareLocation && JS != null)
        {
            GeolocationResult? pos = await JS.InvokeAsync<GeolocationResult>(identifier: "getUserLocation");
            if (pos != null)
            {
                userLatitude = pos.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
                userLongitude = pos.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
                await FetchAstronomyDataAsync();
            }
        }
    }

    void ToggleMoonPhases()
    {
        showMoonPhases = !showMoonPhases;
        if (showMoonPhases && astronomyData == null)
        {
            // Try to fetch if not already loaded
            _ = FetchAstronomyDataAsync();
        }
    }

    // Maps API moon phase values to image filenames in wwwroot/moonphases
    string GetMoonPhaseImage(string? moonPhase)
    {
        if (string.IsNullOrWhiteSpace(moonPhase)) return "moonphases/newmoon.png";
        // Map API values to image filenames
        return moonPhase.ToUpperInvariant() switch
        {
            "NEW_MOON" => "moonphases/newmoon.png",
            "WAXING_CRESCENT" => "moonphases/waxingcrescent.png",
            "FIRST_QUARTER" => "moonphases/firstquarter.png",
            "WAXING_GIBBOUS" => "moonphases/waxinggibbous.png",
            "FULL_MOON" => "moonphases/fullmoon.png",
            "WANING_GIBBOUS" => "moonphases/waninggibbous.png",
            "LAST_QUARTER" => "moonphases/lastquarter.png",
            "WANING_CRESCENT" => "moonphases/waningcrescent.png",
            _ => "moonphases/newmoon.png"
        };
    }

    (string, string) GetCurrentMoonPhase()
    {
        // Simple moon phase calculation based on current date
        (string, string)[]? phases = new[]
        {
            ("New Moon", "moonphases/newmoon.png"),
            ("Waxing Crescent", "moonphases/waxingcrescent.png"),
            ("First Quarter", "moonphases/firstquarter.png"),
            ("Waxing Gibbous", "moonphases/waxinggibbous.png"),
            ("Full Moon", "moonphases/fullmoon.png"),
            ("Waning Gibbous", "moonphases/waninggibbous.png"),
            ("Last Quarter", "moonphases/lastquarter.png"),
            ("Waning Crescent", "moonphases/waningcrescent.png")
        };
        DateTime now = DateTime.UtcNow;
        double synodicMonth = 29.53058867;
        DateTime knownNewMoon = new DateTime(year: 2000, month: 1, day: 6, hour: 18, minute: 14, second: 0, DateTimeKind.Utc); // Reference new moon
        double daysSince = (now - knownNewMoon).TotalDays;
        double currentPhase = daysSince % synodicMonth;
        int phaseIndex = (int)Math.Floor((currentPhase / synodicMonth) * phases.Length) % phases.Length;
        return phases[phaseIndex];
    }

    void ToggleLunarEclipse()
    {
        showLunarEclipse = !showLunarEclipse;
        if (showLunarEclipse && astronomyData == null)
        {
            _ = FetchAstronomyDataAsync();
        }
        if (showLunarEclipse)
        {
            if (string.IsNullOrEmpty(selectedCountry) && string.IsNullOrEmpty(selectedTimezone))
            {
                NextLunarEclipseDate = string.Empty;
                LunarEclipseError = "Please select a Country or Timezone";
            }
            else
            {
                LunarEclipseError = string.Empty;
                NextLunarEclipseDate = GetNextLunarEclipse(selectedCountry, selectedTimezone);
            }
        }
    }

    string GetNextLunarEclipse(string? country, string? timezone)
    {
        // Example: List of known eclipses (future and past)
        DateTime[]? eclipses = new[]
        {
            new DateTime(year: 2023, month: 5, day: 5),
            new DateTime(year: 2023, month: 10, day: 28),
            new DateTime(year: 2024, month: 3, day: 25),
            new DateTime(year: 2024, month: 9, day: 18),
            new DateTime(year: 2025, month: 3, day: 14),
            new DateTime(year: 2025, month: 9, day: 7),
            new DateTime(year: 2026, month: 3, day: 3),
            new DateTime(year: 2026, month: 8, day: 28),
            new DateTime(year: 2027, month: 2, day: 20),
            new DateTime(year: 2027, month: 8, day: 17),
            new DateTime(year: 2028, month: 1, day: 12),
            new DateTime(year: 2028, month: 7, day: 6),
            new DateTime(year: 2028, month: 12, day: 31),
            new DateTime(year: 2029, month: 6, day: 26),
            new DateTime(year: 2029, month: 12, day: 20),
            new DateTime(year: 2030, month: 6, day: 15),
            new DateTime(year: 2030, month: 12, day: 9),
            new DateTime(year: 2031, month: 6, day: 4),
            new DateTime(year: 2031, month: 11, day: 29),
            new DateTime(year: 2032, month: 5, day: 24),
            new DateTime(year: 2032, month: 11, day: 18),
            new DateTime(year: 2033, month: 5, day: 14),
            new DateTime(year: 2033, month: 11, day: 8),
            new DateTime(year: 2034, month: 5, day: 4),
            new DateTime(year: 2034, month: 10, day: 29),
            new DateTime(year: 2035, month: 4, day: 24),
            new DateTime(year: 2035, month: 10, day: 18)
        };
        // Optionally, filter by country/timezone for hemisphere, but here we use all
        DateTime now = DateTime.UtcNow;
        DateTime next = eclipses.FirstOrDefault(d => d > now);
        if (next != default)
        {
            return $"Next visible lunar eclipse: {next:dd/MM/yyyy}";
        }
        // If no future eclipse, show last past one
        DateTime last = eclipses.LastOrDefault(d => d <= now);
        if (last != default)
        {
            return $"Last visible lunar eclipse: {last:dd/MM/yyyy}";
        }
        return "No lunar eclipse data available.";
    }

