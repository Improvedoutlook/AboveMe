    /// <summary>
    /// Meteor shower data model based on American Meteor Society calendar
    /// </summary>
    public class MeteorShowerData
    {
        public string Name { get; set; }
        public DateTime ActiveStart { get; set; }
        public DateTime ActiveEnd { get; set; }
        public DateTime PeakDateUTC { get; set; }
        public TimeSpan PeakTimeUTC { get; set; }
        public DateTime PeakLocal { get; set; } // Calculated based on user timezone
        public string Description { get; set; }
        public HemisphereVisibility VisibilityConstraint { get; set; }
        public string Radiant { get; set; }
        public int ZHR { get; set; }
        public string Velocity { get; set; }
        public string ParentObject { get; set; }
        public int MoonIllumination { get; set; }

        public MeteorShowerData(string name, DateTime activeStart, DateTime activeEnd, DateTime peakDateUTC, TimeSpan peakTimeUTC, string description, HemisphereVisibility visibility, string radiant, int zhr, string velocity, string parentObject, int moonIllumination)
        {
            Name = name;
            ActiveStart = activeStart;
            ActiveEnd = activeEnd;
            PeakDateUTC = peakDateUTC;
            PeakTimeUTC = peakTimeUTC;
            Description = description;
            VisibilityConstraint = visibility;
            Radiant = radiant;
            ZHR = zhr;
            Velocity = velocity;
            ParentObject = parentObject;
            MoonIllumination = moonIllumination;
            PeakLocal = peakDateUTC; // Default, will be calculated
        }
    }

