    private async Task LoadNextWebbImageAsync()
    {
        try
        {
            int nextNumber;
            if (lastWebbNumber <= 0)
            {
                // No previous image — pick a random one from 1..30
                nextNumber = Random.Shared.Next(1, 31);
            }
            else
            {
                int currentIndex = WebbImages.FindIndex(w => w.Number == lastWebbNumber);
                if (currentIndex >= 0)
                {
                    nextNumber = WebbImages[(currentIndex + 1) % WebbImages.Count].Number;
                }
                else
                {
                    nextNumber = Random.Shared.Next(1, 31);
                }
            }

            var selectedImage = WebbImages.First(img => img.Number == nextNumber);
            selectedImagePath = selectedImage.ImagePath;
            selectedTitle = selectedImage.Title;
            lastWebbNumber = selectedImage.Number;

            try
            {
                selectedDescription = await Http.GetStringAsync(selectedImage.DescriptionPath);
            }
            catch
            {
                selectedDescription = "Description unavailable";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading next Webb image: {ex.Message}");
            selectedTitle = "Error loading image";
            selectedDescription = "Description unavailable";
        }
    }

    /// <summary>
    /// Determine user's hemisphere based on country or timezone
    /// </summary>
    private string GetUserHemisphere()
    {
        // Southern Hemisphere: Australia, AET
        // Northern Hemisphere: US, Canada, UK, China, EST/CST/MST/PST/GMT/CET/CST-China
        if (!string.IsNullOrEmpty(selectedCountry))
        {
            return selectedCountry switch
            {
                "Australia" => "Southern",
                "United States" => "Northern",
                "Canada" => "Northern",
                "United Kingdom" => "Northern",
                "China" => "Northern",
                _ => "Northern" // Default to Northern
            };
        }
        else if (!string.IsNullOrEmpty(selectedTimezone))
        {
            return selectedTimezone switch
            {
                "Australian Eastern Time" => "Southern",
                "Eastern Standard Time" => "Northern",
                "Central Standard Time" => "Northern",
                "Mountain Standard Time" => "Northern",
                "Pacific Standard Time" => "Northern",
                "Greenwich Mean Time" => "Northern",
                "Central European Time" => "Northern",
                "China Standard Time" => "Northern",
                _ => "Northern" // Default to Northern
            };
        }
        return "Northern"; // Default
    }

    /// <summary>
    /// Get timezone offset from selected timezone string (e.g., "UTC-5" returns -5 hours)
    /// </summary>
    private TimeSpan GetTimezoneOffset()
    {
        if (!string.IsNullOrEmpty(selectedTimezone))
        {
            // Find the timezone in the Timezones list and parse UTC offset
            var tz = Timezones.FirstOrDefault(t => t.Id == selectedTimezone);
            if (!string.IsNullOrEmpty(tz.Description))
            {
                // Parse "UTC-5" or "UTC+10"
                string utcPart = tz.Description.Replace("UTC", "").Trim();
                if (double.TryParse(utcPart, out double offset))
                {
                    return TimeSpan.FromHours(offset);
                }
            }
        }
        return TimeSpan.Zero; // Default to UTC
    }

    /// <summary>
    /// Get visible meteor showers filtered by hemisphere and time, with timezone-adjusted peak times
    /// Shows only upcoming and currently active meteor showers
    /// </summary>
    private List<MeteorShowerData> GetVisibleMeteorShowers()
    {
        string hemisphere = GetUserHemisphere();
        TimeSpan timezoneOffset = GetTimezoneOffset();
        DateTime now = DateTime.UtcNow;

        return AllMeteorShowers
            // Filter by hemisphere visibility
            .Where(shower => shower.VisibilityConstraint == HemisphereVisibility.All ||
                           (shower.VisibilityConstraint == HemisphereVisibility.NorthernHemisphereOnly && hemisphere == "Northern") ||
                           (shower.VisibilityConstraint == HemisphereVisibility.SouthernHemisphereOnly && hemisphere == "Southern"))
            // Show only future showers (active end date is today or later)
            .Where(shower => shower.ActiveEnd.Date >= now.Date)
            // Convert peak time to user's timezone
            .Select(shower =>
            {
                var localPeak = shower.PeakDateUTC.Add(shower.PeakTimeUTC).Add(timezoneOffset);
                return new MeteorShowerData(
                    shower.Name,
                    shower.ActiveStart,
                    shower.ActiveEnd,
                    shower.PeakDateUTC,
                    shower.PeakTimeUTC,
                    shower.Description,
                    shower.VisibilityConstraint,
                    shower.Radiant,
                    shower.ZHR,
                    shower.Velocity,
                    shower.ParentObject,
                    shower.MoonIllumination
                ) { PeakLocal = localPeak };
            })
            // Sort chronologically by active start date
            .OrderBy(shower => shower.ActiveStart)
            .ToList();
    }

