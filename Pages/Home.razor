@page "/"

@using Microsoft.JSInterop
@using System.Net.Http
@using System.Text.Json.Serialization
@using AboveMe.Services

<div class="aboveme-form">
    <div class="form-group">
        <label for="country">Country</label>
        <select id="country" class="form-control" @bind="selectedCountry" @bind:after="OnCountryChanged">
            <option value="">Select Country</option>
            @foreach (string country in Countries)
            {
                <option value="@country">@country</option>
            }
        </select>
    </div>
    <div class="form-group">
        <label for="timezone">Timezone</label>
        <select id="timezone" class="form-control" @bind="selectedTimezone" @bind:after="OnTimezoneChanged">
            <option value="">Select Timezone</option>
            @foreach ((string Id, string Display, string Description) tz in Timezones)
            {
                <option value="@tz.Id">@tz.Display @("(" + tz.Description + ")")</option>
            }
        </select>
    </div>
    <div class="form-group">
        <label for="city">City</label>
        <input id="city" class="form-control" type="text" @bind="selectedCity" @bind:after="OnCityChanged" placeholder="Enter your city" />
    </div>


    <div class="form-group text-center">
        <button type="button" class="btn btn-sm btn-outline-primary mb-1" @onclick="OnShareLocationClicked" title="Share my location">
            <span class="oi oi-location"></span> 📍
        </button>
        <div style="font-size:0.95em; color:#fff;">Share my location</div>
    </div>
    <div class="form-group mt-3">
        <button class="btn btn-primary" @onclick="ToggleMoonPhases">@((showMoonPhases ? "Hide" : "Show") + " Moon Data")</button>
    </div>
    @if (showMoonPhases)
    {
    <div class="moon-phase-display mt-4 text-center" style="color: #fff;">
            @if (isLoadingAstronomyData)
            {
                <div class="text-info">Loading moon phase...</div>
            }
            else if (astronomyData == null)
            {
                <div class="text-warning">Unable to load moon phase data. Please check your location and try again.</div>
            }
            else if (astronomyData != null)
            {
                string? moonPhase = astronomyData.MoonPhase ?? "NEW_MOON";
                string imageFile = moonPhase.ToUpperInvariant() switch
                {
                    "NEW_MOON" => "NEW_MOON.jpg",
                    "WAXING_CRESCENT" => "WAXING_CRESCENT.jpg",
                    "FIRST_QUARTER" => "FIRST_QUARTER.jpg",
                    "WAXING_GIBBOUS" => "WAXING_GIBBOUS.jpg",
                    "FULL_MOON" => "FULL_MOON.jpg",
                    "WANING_GIBBOUS" => "WANING_GIBBOUS.jpg",
                    "LAST_QUARTER" => "LAST_QUARTER.jpg",
                    "WANING_CRESCENT" => "WANING_CRESCENT.jpg",
                    _ => "NEW_MOON.jpg"
                };
                <img src="moonphases/@imageFile" alt="@moonPhase.Replace(oldValue: "_", newValue: " ")" class="moon-img" style="max-width:120px;" />
                <div class="moon-phase-label mt-2">@astronomyData.MoonPhase</div>
                <div class="moon-phase-details mt-2">
                    <span style="color:#fff;">Moonrise: <b>@FormatTime(astronomyData.Moonrise)</b></span><br />
                    <span style="color:#fff;">Moonset: <b>@FormatTime(astronomyData.Moonset)</b></span><br />
                    <span style="color:#fff;">Moon Illumination: <b>@astronomyData.MoonIlluminationPercentage%</b></span><br />
                    <span style="color:#fff;">Sunrise: <b>@FormatTime(astronomyData.Sunrise)</b></span><br />
                    <span style="color:#fff;">Sunset: <b>@FormatTime(astronomyData.Sunset)</b></span><br />
                    <span style="color:#fff;">Solar Noon: <b>@FormatTime(astronomyData.SolarNoon)</b></span><br />
                    <span style="color:#fff;">Day Length: <b>@astronomyData.DayLength</b></span><br />
                    <span style="color:#fff;">Current Time: <b>@FormatTime(astronomyData.CurrentTime, showSeconds: true)</b></span>
                </div>
            }
        </div>
    }
    @* //Get Lunar Eclipse Data to render *@
    <div class="form-group mt-3">
        <button class="btn btn-primary" @onclick="ToggleLunarEclipse">@((showLunarEclipse ? "Hide" : "Show") + " Next Lunar Eclipse")</button>
    </div>
    @if (showLunarEclipse)
    {
        <div class="lunar-eclipse-display mt-4 text-center">
            @if (isLoadingAstronomyData)
            {
                <div class="text-info">Loading lunar eclipse data...</div>
            }
            else if (!string.IsNullOrEmpty(LunarEclipseError))
            {
                <div class="text-warning" style="color: #ffc107;">@LunarEclipseError</div>
            }
            else if (astronomyData == null)
            {
                <div class="text-warning">Unable to load lunar eclipse data. Please check your location and try again.</div>
            }
            else
            {
                <div class="lunar-eclipse-label mt-2" style="color:#fff;"><b>@NextLunarEclipseDate</b></div>
            }
        </div>
    }
    <div class="form-group mt-3">
        <button class="btn btn-primary" @onclick="ToggleConstellations">@((showConstellations ? "Hide" : "Show") + " Astronomy Picture of the Day")</button>
    </div>
    @if (showConstellations)
    {
        <div class="constellations-display mt-4 text-center">
            @if (isLoadingNasaData)
            {
                <div class="text-info">Loading NASA data...</div>
            }
            else if (!string.IsNullOrEmpty(NasaError))
            {
                <div class="text-warning" style="color: #ffc107;">@NasaError</div>
            }
            else if (nasaData == null)
            {
                <div class="text-warning">Unable to load NASA data. Please check your API key and try again.</div>
            }
            else
            {
                if (!string.IsNullOrWhiteSpace(nasaData.Url))
                {
                    if (nasaData.MediaType == "image")
                    {
                        <img src="@nasaData.Url" alt="NASA Astronomy Picture of the Day" style="max-width:100%; border-radius:8px; margin-bottom:1em;" />
                    }
                    else if (nasaData.MediaType == "video")
                    {
                        <div style="max-width:100%; margin-bottom:1em;">
                            @if (IsDirectVideoUrl(nasaData.Url))
                            {
                                <video controls style="width:100%; height:auto; border-radius:8px; background:#000;" poster="@nasaData.HdUrl">
                                    <source src="@nasaData.Url" type="@GetVideoMimeType(nasaData.Url)" />
                                    Your browser does not support the video tag. <a href="@nasaData.Url" target="_blank" rel="noopener noreferrer">Open video</a>
                                </video>
                            }
                            else if (!string.IsNullOrEmpty(GetYouTubeEmbedUrl(nasaData.Url)))
                            {
                                <iframe src="@GetYouTubeEmbedUrl(nasaData.Url)" 
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                                        allowfullscreen
                                        style="width:100%; height:500px; border:0; border-radius:8px;">
                                </iframe>
                            }
                            else
                            {
                                <!-- Some external video hosts block framing via X-Frame-Options. Provide iframe + fallback link. -->
                                <iframe src="@nasaData.Url" 
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                                        allowfullscreen
                                        style="width:100%; height:500px; border:0; border-radius:8px;">
                                </iframe>
                                <div style="margin-top:0.5em;"><a href="@nasaData.Url" target="_blank" rel="noopener noreferrer" style="color:#9cf;">Open video in new tab</a></div>
                            }
                        </div>
                    }
                }
                <div style="max-width:920px; margin:0 auto 1.2em; padding:0 1rem;">
                    <div style="color:#fff; font-weight:bold; font-size:1.25em; margin-bottom:0.6em; text-align:center;">@nasaData.Title</div>
                    <div style="color:#ddd; font-size:1rem; line-height:1.6; text-align:left; max-width:800px; margin:0 auto;">
                        @nasaData.Explanation
                    </div>
                </div>
            }
        </div>
    }
    <div class="form-group mt-3">
        <button class="btn btn-primary" @onclick="ToggleWebb">@((showWebb ? "Hide" : "Show") + " Webb Space Telescope")</button>
    </div>
    @if (showWebb)
    {
        <div class="webb-display mt-4 text-center">
            <img src="@selectedImagePath" 
                 alt="@selectedTitle" 
                 style="max-width:100%; border-radius:8px; margin-bottom:1em;" 
                 role="img" />
            
            <div style="color:#fff; font-weight:bold; font-size:1.3em; margin-bottom:0.8em;">@selectedTitle</div>
            <div style="color:#ddd; font-size:1em; line-height:1.6; text-align:left; max-width:800px; margin:0 auto;">
                @selectedDescription
            </div>
        </div>
    }
    <div class="form-group mt-3">
        <button class="btn btn-primary" @onclick="ToggleComets">@((showComets ? "Hide" : "Show") + " Comet Data")</button>
    </div>
    @if (showComets)
    {
        <div class="comets-display mt-4">
            @if (isLoadingComets)
            {
                <div class="text-info text-center">Loading comet forecasts…</div>
            }
            else if (!string.IsNullOrEmpty(CometError))
            {
                <div class="text-warning text-center" style="color: #ffc107;">@CometError</div>
            }
            else if (VisibleComets == null || VisibleComets.Count == 0)
            {
                <div class="text-warning text-center">No comet forecasts available. Try sharing your location for personalized results.</div>
            }
            else
            {
                <ul class="list-unstyled" style="color:#fff;">
                @foreach (CometForecast comet in VisibleComets)
                {
                    <li class="comet-item" style="margin-bottom: 1.25em; padding: 1em 1.2em; background: rgba(255,255,255,0.06); border-radius: 8px; text-align: left;">
                        <div style="font-weight: bold; font-size: 1.1em;">
                            Comet @comet.Name <span style="color:#aaa; font-weight: normal;">(@comet.Designation)</span>
                            <span style="background:@GetStatusColor(comet.DisplayStatus); color:#fff; padding: 0.15em 0.55em; border-radius: 4px; font-size: 0.7em; margin-left:0.4em; vertical-align: middle;">@comet.DisplayStatus</span>
                        </div>
                        <div style="color: #ddd; margin-top: 0.4em; font-size: 0.95em;">
                            <span><b>Perihelion:</b> @comet.PerihelionDate.ToString("MMM dd, yyyy")</span>
                            <span style="margin-left: 1em;"><b>Peak window:</b> @comet.PeakWindowStart.ToString("MMM dd") – @comet.PeakWindowEnd.ToString("MMM dd, yyyy")</span>
                            <span style="margin-left: 1em;"><b>Peak mag:</b> @comet.PeakMagnitude.ToString("0.#")</span>
                        </div>
                        <div style="margin-top: 0.55em; line-height: 1.5;">@comet.Summary</div>
                        @if (!string.IsNullOrWhiteSpace(comet.Notes))
                        {
                            <div style="margin-top: 0.4em; color: #aaa; font-size: 0.85em; font-style: italic;">@comet.Notes</div>
                        }
                    </li>
                }
                </ul>
                @if (!string.IsNullOrEmpty(userLatitude))
                {
                    <div class="text-center" style="color: #aaa; font-size: 0.85em; margin-top: 0.5em;">
                        Filtered for your latitude (~@userLatitude°). Share location for finer visibility modeling.
                    </div>
                }
                else
                {
                    <div class="text-center" style="color: #aaa; font-size: 0.85em; margin-top: 0.5em;">
                        Showing the global catalog. Share your location to filter by latitude.
                    </div>
                }
            }
        </div>
    }
    <div class="form-group mt-3">
        <button class="btn btn-primary" @onclick="ToggleMeteorShowers">@((showMeteorShowers ? "Hide" : "Show") + " Meteor Showers")</button>
    </div>
    @if (showMeteorShowers)
    {
        <div class="meteor-showers-display mt-4">
            @if (!string.IsNullOrEmpty(MeteorShowerError))
            {
                <div class="text-warning text-center" style="color: #ffc107;">@MeteorShowerError</div>
            }
            else if (VisibleMeteorShowers == null || VisibleMeteorShowers.Count == 0)
            {
                <div class="text-warning text-center">No upcoming meteor showers visible from your location in 2025-2026.</div>
            }
            else
            {
                <div class="shower-list">
                    @for (int i = 0; i < Math.Min(currentShowerDisplayCount, VisibleMeteorShowers.Count); i++)
                    {
                        var shower = VisibleMeteorShowers[i];
                        <div class="shower-card" style="background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 12px; padding: 1.5rem; margin-bottom: 1.5rem; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.37);">
                            <div style="color:#fff; font-weight:bold; font-size:1.2em; margin-bottom:0.5em;">@shower.Name</div>
                            <div style="color:#ddd; margin-bottom:0.3em;"><strong>Active:</strong> @shower.ActiveStart.ToString("MMM dd") - @shower.ActiveEnd.ToString("MMM dd, yyyy")</div>
                            <div style="color:#ddd; margin-bottom:0.3em;"><strong>Peak:</strong> @shower.PeakLocal.ToString("MMM dd, yyyy 'at' h:mm tt")</div>
                            <div style="color:#ddd; margin-bottom:0.8em; line-height:1.5;">@shower.Description</div>
                            <div style="color:#aaa; font-size:0.9em;">
                                <div style="margin-bottom:0.5em;">
                                    <div><strong>Radiant:</strong> @shower.Radiant</div>
                                    <div style="font-size:0.85em; opacity:0.7; margin-left:0.5em;">The point in the sky where meteors appear to originate</div>
                                </div>
                                <div style="margin-bottom:0.5em;">
                                    <div><strong>ZHR:</strong> @shower.ZHR</div>
                                    <div style="font-size:0.85em; opacity:0.7; margin-left:0.5em;">Max meteors per hour under perfect dark skies</div>
                                </div>
                                <div style="margin-bottom:0.5em;">
                                    <div><strong>Velocity:</strong> @shower.Velocity</div>
                                    <div style="font-size:0.85em; opacity:0.7; margin-left:0.5em;">Speed of meteors entering Earth's atmosphere</div>
                                </div>
                                <div style="margin-bottom:0.5em;">
                                    <div><strong>Parent Object:</strong> @shower.ParentObject</div>
                                    <div style="font-size:0.85em; opacity:0.7; margin-left:0.5em;">Comet/asteroid that created the debris trail</div>
                                </div>
                                <div style="margin-bottom:0.5em;">
                                    <div><strong>Moon Illumination:</strong> @shower.MoonIllumination%</div>
                                    <div style="font-size:0.85em; opacity:0.7; margin-left:0.5em;">Moon brightness (higher = more light interference)</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                @if (currentShowerDisplayCount < VisibleMeteorShowers.Count)
                {
                    <div class="text-center mt-3">
                        <button class="btn btn-outline-light" @onclick="ShowMoreMeteorShowers">Show More</button>
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    // Helper to determine if the selected country/timezone is US or US timezone
    private bool IsUSLocale()
    {
        // Always return true so all countries and timezones use AM/PM formatting
        return true;
    }

    // Format time as 12-hour with AM/PM for US, otherwise return as-is
    private string FormatTime(string? time, bool showSeconds = false)
    {
        if (string.IsNullOrWhiteSpace(time)) return string.Empty;
        // Always format as 12-hour with AM/PM for all countries/timezones
        DateTime dt;
        if (DateTime.TryParseExact(time, new[] { "H:mm", "HH:mm", "H:mm:ss", "HH:mm:ss", "H:mm:ss.fff", "HH:mm:ss.fff" }, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out dt))
        {
            return showSeconds ? dt.ToString(format: "h:mm:ss tt") : dt.ToString(format: "h:mm tt");
        }
        return time;
    }
