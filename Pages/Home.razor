    private async Task LoadUserPreferencesAsync()
    {
        try
        {
            var preferences = await LocalStorage.GetItemAsync<UserLocationPreferences>("userLocationPreferences");
            if (preferences != null)
            {
                selectedCountry = preferences.Country ?? "";
                selectedCity = preferences.City ?? "";
                selectedTimezone = preferences.Timezone ?? "";
                userLatitude = preferences.Latitude;
                userLongitude = preferences.Longitude;
                
                // Update cached values to match loaded preferences
                lastCountry = selectedCountry;
                lastCity = selectedCity;
                lastTimezone = selectedTimezone;
                lastLatitude = userLatitude;
                lastLongitude = userLongitude;
                
                Console.WriteLine($"Loaded user preferences: Country={selectedCountry}, City={selectedCity}, Timezone={selectedTimezone}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user preferences: {ex.Message}");
